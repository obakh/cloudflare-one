{
	"name": "monorepo",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"check-types": "turbo check-types",
		"clean": "turbo clean && rimraf node_modules",
		"format": "biome format --write .",
		"lint": "biome check apps packages e2e",
		"lint:fix": "biome check --write --unsafe apps packages e2e",
		"lint:apps": "biome check --write --unsafe apps",
		"lint:packages": "biome check --write --unsafe packages",
		"test": "turbo test",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:coverage": "turbo test -- --coverage",
		"deploy": "turbo deploy",
		"deploy:preview": "turbo deploy -- --env preview",
		"deploy:web": "pnpm --filter @repo/web deploy",
		"deploy:blog": "pnpm --filter @repo/blog deploy",
		"deploy:admin": "pnpm --filter @repo/admin deploy",
		"preview:web": "pnpm --filter @repo/web versions:upload",
		"preview:blog": "pnpm --filter @repo/blog versions:upload",
		"preview:admin": "pnpm --filter @repo/admin versions:upload",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.12",
		"@commitlint/cli": "^19.0.0",
		"@commitlint/config-conventional": "^19.0.0",
		"@playwright/test": "^1.59.1",
		"@vitest/coverage-v8": "^2.1.8",
		"husky": "^9.0.0",
		"lint-staged": "^15.0.0",
		"rimraf": "^6.0.0",
		"turbo": "^2.9.6"
	},
	"packageManager": "pnpm@9.15.0",
	"engines": {
		"node": ">=20.16.0"
	}
}
