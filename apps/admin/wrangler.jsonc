{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "admin",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist"
	},

	// Sentry version metadata binding (required for @repo/observability/sentry)
	// "version_metadata": { "binding": "CF_VERSION_METADATA" },

	// Hyperdrive connection to PostgreSQL
	// Create with: wrangler hyperdrive create admin-db --connection-string="postgresql://user:pass@host:5432/db"
	// "hyperdrive": [
	//   {
	//     "binding": "DB",
	//     "id": "YOUR_HYPERDRIVE_ID",
	//     "localConnectionString": "postgresql://myuser:mypassword@localhost:5432/mydatabase"
	//   }
	// ],

	// Secrets: use .dev.vars for local dev, wrangler secret for production
	// See .dev.vars.example for available variables

	"placement": {
		"mode": "smart"
	},
	"observability": {
		"enabled": true
		// Sentry integration (configure destinations in Cloudflare dashboard first):
		// "traces": {
		//   "enabled": true,
		//   "destinations": ["sentry-traces"]
		// },
		// "logs": {
		//   "enabled": true,
		//   "destinations": ["sentry-logs"]
		// }
	}
}
