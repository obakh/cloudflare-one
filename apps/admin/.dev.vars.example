# ===========================================
# Admin App Environment Variables
# ===========================================
# Copy this file to .dev.vars and fill in your values
# cp .dev.vars.example .dev.vars

# -----------------------------------------
# Database (Hyperdrive)
# -----------------------------------------
# Local PostgreSQL connection string for development
# Used when Hyperdrive is configured in wrangler.jsonc
# DATABASE_URL="postgresql://myuser:mypassword@localhost:5432/mydatabase"

# -----------------------------------------
# API Authentication
# -----------------------------------------
# Token for protecting admin API endpoints
API_TOKEN="your-secret-api-token"

# -----------------------------------------
# Monitoring (Sentry)
# -----------------------------------------
# Sentry DSN from your project settings
# SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"

# -----------------------------------------
# Add your custom environment variables below
# -----------------------------------------
