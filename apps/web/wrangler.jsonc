{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "web",
	"main": "server.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],

	// Sentry version metadata binding (required for @repo/observability/sentry)
	// "version_metadata": { "binding": "CF_VERSION_METADATA" },

	// Uncomment to enable Hyperdrive (PostgreSQL connection pooling)
	// Required for @repo/auth
	// "hyperdrive": [
	//   {
	//     "binding": "DB",
	//     "id": "YOUR_HYPERDRIVE_ID",
	//     "localConnectionString": "postgresql://myuser:mypassword@localhost:5432/mydatabase"
	//   }
	// ],

	// Secrets: use .dev.vars for local dev, wrangler secret for production
	// See .dev.vars.example for available variables

	"placement": {
		"mode": "smart"
	},
	"observability": {
		"enabled": true
		// Sentry integration (configure destinations in Cloudflare dashboard first):
		// "traces": {
		//   "enabled": true,
		//   "destinations": ["sentry-traces"]
		// },
		// "logs": {
		//   "enabled": true,
		//   "destinations": ["sentry-logs"]
		// }
	},
	"upload_source_maps": true
}
