---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
import { ThemeToggle } from './ThemeToggle';
---

<header class="sticky top-0 z-50 bg-background/80 backdrop-blur-sm border-b border-border">
	<nav class="max-w-4xl mx-auto px-4 flex items-center justify-between h-14">
		<h2 class="text-lg font-semibold">
			<a href="/" class="text-foreground hover:text-foreground/80 no-underline">{SITE_TITLE}</a>
		</h2>
		<div class="flex items-center gap-1">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<ThemeToggle client:load />
		</div>
	</nav>
</header>
