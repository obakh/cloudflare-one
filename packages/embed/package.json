{
	"name": "@repo/embed",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./iframe": {
			"types": "./src/iframe/index.tsx",
			"default": "./src/iframe/index.tsx"
		},
		"./script": {
			"types": "./src/script/index.ts",
			"default": "./src/script/index.ts"
		},
		"./messaging": {
			"types": "./src/messaging/index.ts",
			"default": "./src/messaging/index.ts"
		}
	},
	"scripts": {
		"check-types": "tsc --noEmit"
	},
	"dependencies": {
		"react": "^19.0.0"
	},
	"devDependencies": {
		"@repo/config": "workspace:*",
		"@types/react": "^19.0.0",
		"typescript": "^6.0.2"
	}
}
