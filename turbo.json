{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["build/**", ".react-router/**", "dist/**", ".astro/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"test": {
			"dependsOn": ["^build"],
			"cache": false
		},
		"lint": {
			"dependsOn": ["^build"]
		},
		"check-types": {
			"dependsOn": ["^build"]
		},
		"clean": {
			"cache": false
		}
	}
}
